---
import BaseHead from "../components/BaseHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { pageOgImage } from "../lib/studio/pages";
import StudioDock from "../components/StudioDock.astro";
import { runtimeSite } from "../data/site";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/site.css";

interface Props {
	title: string;
	description: string;
	image?: string;
	brandHref?: string;
}

const { title, description, image, brandHref = "/" } = Astro.props;
const { site } = await runtimeSite(Astro.locals);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image ?? pageOgImage(Astro.url.pathname)} />
		<link rel="preload" href="/fonts/fraunces-600.woff2" as="font" type="font/woff2" crossorigin />
	</head>
	<body class="v2">
		<SiteHeader brandHref={brandHref} site={site} />

		<main>
			<slot />
		</main>

		<SiteFooter site={site} />

		<StudioDock />
	</body>
</html>

# Copy this file to .env for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for the live site.
# Never commit your real .env file (it's already in .gitignore).

# Password for the Studio editor at /studio. Pick something long.
STUDIO_PASSCODE=

# Anthropic API key, used by the Studio's AI assistant on the live site.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Vercel Blob token: where Studio edits (text, pages, menus, images) are saved.
# Vercel → Storage → Create → Blob, connect it to the project, and this is set
# for you. For local saving, copy the token into this file too.
BLOB_READ_WRITE_TOKEN=

# Your public address, e.g. https://example.com (used for canonical links,
# the sitemap and www → apex redirects).
PUBLIC_SITE_URL=

# Optional: override the AI models.
# STUDIO_API_MODEL=claude-sonnet-5   # hosted (Anthropic API)
# STUDIO_MODEL=sonnet                 # local (Claude Code CLI)
